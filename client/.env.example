# ==============================================================================
# ProofRail AI - Client Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to 'client/.env' and adjust if necessary.
# e.g.: cp .env.example .env
# ==============================================================================

# Client Development Server Port
VITE_PORT=5173

# Server API URL (Target for Vite Development Proxy)
# In development, Vite will automatically proxy '/api' and '/uploads' to this URL
VITE_BACKEND_URL=http://localhost:8080

# Base API Request Endpoint Path / URL
# Default '/api' uses the Vite development proxy (recommended to prevent CORS issues).
# For standalone or production setups where client talks directly to the server API:
# VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_BASE_URL=/api
