# ProofRail AI - Environment Configuration Example

# Server Configuration
PORT=8080
APP_URL=http://localhost:5173

# Database Configuration (supports 'sqlite' or 'mysql')
DB_DRIVER=sqlite
DB_DSN=proofrail.db
# For MySQL:
# DB_DRIVER=mysql
# DB_DSN=root:password@tcp(127.0.0.1:3306)/proofrail_db?charset=utf8mb4&parseTime=True&loc=Local

# Authentication
JWT_SECRET=your-secure-random-jwt-secret-here

# PayPal Sandbox Integration
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# AI Model Configuration (Optional - fallback rule parser active when key omitted)
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite

# Storage
STORAGE_DIR=./uploads

