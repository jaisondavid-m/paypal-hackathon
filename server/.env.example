# ==============================================================================
# ProofRail AI - Server Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to 'server/.env' (or root '.env') and fill in your values.
# e.g.: cp .env.example .env
# ==============================================================================

# Server Configuration
PORT=8080
APP_URL=http://localhost:5173
STORAGE_DIR=./uploads

# Database Configuration
# Supported drivers: 'sqlite' or 'mysql'
DB_DRIVER=sqlite
DB_DSN=proofrail.db

# For MySQL Database (uncomment to use):
# DB_DRIVER=mysql
# DB_DSN=root:password@tcp(127.0.0.1:3306)/proofrail_db?charset=utf8mb4&parseTime=True&loc=Local

# Authentication
# Secret key used to sign and verify JWT tokens
JWT_SECRET=proofrail-super-secret-jwt-key-2026-hackathon-token

# PayPal Sandbox Integration
# Obtain credentials from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# AI Model Configuration (Gemini API)
# Optional: If left blank, ProofRail automatically uses its built-in rule-based
# parser for milestone extraction, ambiguity detection, and dispute dossier analysis.
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
